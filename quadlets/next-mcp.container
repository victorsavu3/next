[Unit]
Description=Next Task Manager MCP Server
After=network-online.target
Wants=network-online.target

[Container]
Image=forgejo.victorsavu.eu/victor/next-mcp:latest
PublishPort=3000:3000

# Persistent storage.
# Option A — named volumes per directory (recommended; each independently backed up):
Volume=next-tasks:/data/tasks:Z
Volume=next-state:/data/state:Z
Volume=next-config:/data/config:Z
# Option B — single host directory covering the whole /data tree:
#   Volume=/var/next-mcp/data/:/data/:Z
#   (creates tasks/, state/, and config/ subdirectories automatically on first start)

# TOML config file — place config.toml in the next-config volume at
#   next-mcp/config.toml  (resolves to /data/config/next-mcp/config.toml, since
#   the image sets XDG_CONFIG_HOME=/data/config).
# See quadlets/next-mcp.config.toml.example for the full schema.

# Secrets — provision with `podman secret create`, then reference them from
# config.toml via the *_file forms (they mount read-only at /run/secrets/<name>):
#   podman secret create next_bearer_token -   # paste token, Ctrl-D
#   podman secret create next_git_token -
# and in config.toml:
#   bearer_token_file = "/run/secrets/next_bearer_token"
#   [git]
#   token_file = "/run/secrets/next_git_token"
Secret=next_bearer_token,type=mount
#Secret=next_webhook_token,type=mount
#Secret=next_git_token,type=mount

# Env vars remain a permanent top-precedence override (env > config > default).
# Uncomment to supply any value (e.g. secrets) via an env file instead of the
# config-file/secret mechanism above:
#EnvironmentFile=%h/.config/next-mcp/env

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
