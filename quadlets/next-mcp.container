[Unit]
Description=Next Task Manager MCP Server
After=network-online.target
Wants=network-online.target

[Container]
Image=forgejo.victorsavu.eu/victor/next-mcp:latest
PublishPort=3000:3000

# Persistent storage.
# Option A — two named volumes (recommended, each independently backed up):
Volume=next-tasks:/data/tasks:Z
Volume=next-state:/data/state:Z
# Option B — single host directory covering the whole /data tree:
#   Volume=/var/next-mcp/data/:/data/:Z
#   (creates tasks/ and state/ subdirectories automatically on first start)

# Secrets and config — keep this file at ~/.config/next-mcp/env (chmod 600)
EnvironmentFile=%h/.config/next-mcp/env

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
