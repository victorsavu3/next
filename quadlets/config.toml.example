# next CLI configuration
# Location: $XDG_CONFIG_HOME/task-manager/config.toml
#           (typically ~/.config/task-manager/config.toml)
#
# All fields are optional; omitted fields use the defaults shown below.

# ── General ────────────────────────────────────────────────────────────────────

# Default repository root. When set, `next` uses this path from any directory
# instead of walking up from $PWD looking for a tasks repo.
#repository = "/home/alice/tasks"

# Automatically sync with the remote after each mutation command (next add,
# next done, next edit, …). Equivalent to always passing --autosync.
# Default: false
#autosync = false

# Cap `next list` output. Same as passing --limit N on each invocation.
# Unset means no cap (all matching tasks are shown).
#list_limit = 20

# Number of tasks shown by `next next`.
# Default: 10
#next_count = 10

# Days ahead shown by `next forecast`.
# Default: 90
#forecast_horizon_days = 90

# ── Sync ───────────────────────────────────────────────────────────────────────

[sync]

# Use `git pull` / `git push` shell subprocesses instead of libgit2 bindings.
# Enable this when your SSH key is managed by a keychain, 1Password SSH agent,
# or any non-standard agent socket that libgit2 cannot reach.
# Default: false
#git_subprocess = false

# Pull from the remote before answering a query so you always see up-to-date
# data. The pull is best-effort and never blocks a command. Bypass it for a
# single invocation with `--offline`.
# Default: true
#pull_before_query = true

# How long (seconds) a local copy stays "fresh" after a pull. A pull is skipped
# if the last one completed within this window.
# Default: 3600 (1 hour)
#staleness_secs = 3600

# Timeout (seconds) for the pre-query pull before it is abandoned.
# Default: 10
#pull_timeout_secs = 10

# System-default interval (seconds) between periodic plugin syncs. This is the
# lowest-priority default; a plugin's own default and per-plugin user overrides
# take precedence over this value.
# Default: 86400 (1 day)
#plugin_sync_default_secs = 86400
