# next-mcp environment file
# Copy to ~/.config/next-mcp/env and set chmod 600
#
# All variables are read at container startup; no restart needed to apply
# changes — just run: systemctl --user restart next-mcp

# ── Authentication ─────────────────────────────────────────────────────────────

# Bearer token that MCP clients must supply.
# Generate with: openssl rand -hex 32
NEXT_BEARER_TOKEN=change-me

# Bearer token for the POST /webhook/sync endpoint (separate from the MCP token).
# If unset, the webhook route is disabled entirely.
# Generate with: openssl rand -hex 32
#NEXT_WEBHOOK_TOKEN=

# ── Git identity ──────────────────────────────────────────────────────────────

# Name and email used for git commits made by next-mcp.
# If unset, the defaults "next-mcp" and "next-mcp@unknown" are used.
#NEXT_GIT_AUTHOR_NAME=next-mcp
#NEXT_GIT_AUTHOR_EMAIL=next-mcp@unknown

# ── Git repository ─────────────────────────────────────────────────────────────

# HTTPS URL of the tasks repository to clone on first start.
# On subsequent starts the existing volume is used and this variable is ignored.
# Credentials may be provided separately (preferred) or embedded in the URL.
NEXT_GIT_URL=https://git.example.com/user/tasks.git

# Git username and token/password for HTTPS authentication.
# Alternatively, embed them in NEXT_GIT_URL as https://user:token@host/repo.git
# (embedded credentials are stripped from logs automatically).
NEXT_GIT_USER=user
NEXT_GIT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Server ─────────────────────────────────────────────────────────────────────

# Address and port to listen on inside the container.
# The quadlet maps this to a host port via PublishPort=.
#NEXT_BIND_ADDR=0.0.0.0:3000

# Local path for the cloned repository (inside the container).
# Must match the container-side mount point of the next-tasks volume.
#NEXT_REPO_PATH=/data/tasks

# ── Sync ───────────────────────────────────────────────────────────────────────

# Periodic background pull+push interval in seconds.
# Set to 0 to disable periodic sync entirely.
# Default: 86400 (once a day)
NEXT_SYNC_INTERVAL=3600

# Seconds to wait after the last autosync=false mutation before firing a
# deferred sync. Keeps bulk edits snappy while ensuring data is not left
# un-pushed indefinitely. Default: 30
#NEXT_DEFERRED_SYNC_DELAY_SECS=30

# ── Pull-before-query ──────────────────────────────────────────────────────────

# Whether to pull from the remote before answering a query, so clients always
# see up-to-date data. Set to "false" to disable (useful if the remote is slow
# or unavailable). Default: true
#NEXT_PULL_BEFORE_QUERY=true

# How long (seconds) a local copy stays "fresh" after a pull. A pull is skipped
# if the last one completed within this window. Default: 3600 (1 hour)
#NEXT_STALENESS_SECS=3600

# Timeout (seconds) for the pre-query pull. Default: 10
#NEXT_PULL_TIMEOUT_SECS=10
