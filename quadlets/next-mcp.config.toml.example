# next-mcp configuration file
# Default location inside the container: /data/config/next-mcp/config.toml
#   (XDG_CONFIG_HOME=/data/config is set in the image).
# Override the path with `next-mcp --config <path>` or NEXT_MCP_CONFIG.
#
# Precedence for every value: environment variable > this file > built-in
# default. Existing NEXT_* env deployments keep working unchanged.
# Absent fields fall back to the built-in defaults shown below.
#
# ── Secrets ─────────────────────────────────────────────────────────────────────
# bearer_token, webhook_token and git.token each accept EXACTLY ONE of three
# forms, so the config file itself can stay non-secret (references only):
#   <name>        = "literal"          # inline (keep the file chmod 600)
#   <name>_file   = "/run/secrets/x"   # read from a file — pairs with podman Secret=
#   <name>_env    = "SOME_VAR"         # read from another environment variable
# Setting more than one form for the same secret is an error. The matching
# legacy NEXT_* env var (e.g. NEXT_BEARER_TOKEN) still overrides all of them.

# ── Authentication ─────────────────────────────────────────────────────────────

# Bearer token that MCP clients must supply.
# Required — set one form here, or via NEXT_BEARER_TOKEN.
# Generate with: openssl rand -hex 32
bearer_token = "change-me"
# …or reference a podman secret mounted at /run/secrets/next_bearer_token:
#bearer_token_file = "/run/secrets/next_bearer_token"
# …or name an environment variable that holds it:
#bearer_token_env = "NEXT_BEARER_TOKEN_VALUE"

# Separate bearer token for the POST /webhook/sync endpoint.
# If absent (and NEXT_WEBHOOK_TOKEN is unset), the endpoint is disabled.
#webhook_token = ""
#webhook_token_file = "/run/secrets/next_webhook_token"
#webhook_token_env = "NEXT_WEBHOOK_TOKEN_VALUE"

# ── Server ─────────────────────────────────────────────────────────────────────

# Address and port to listen on inside the container.
# Default: "0.0.0.0:3000"
#bind_addr = "0.0.0.0:3000"

# Local path for the cloned task repository.
# Must match the container-side mount point of the tasks volume.
# Default: "/data/tasks"
#repo_path = "/data/tasks"

# ── Git ────────────────────────────────────────────────────────────────────────

[git]

# HTTPS URL of the tasks repository to clone on first start.
# Ignored on subsequent starts once the volume already contains a repo.
url = "https://git.example.com/user/tasks.git"

# Credentials for HTTPS authentication.
# Alternatively embed them in the URL as https://user:token@host/repo.git
# (embedded credentials are stripped from logs automatically).
user  = "user"
# token accepts the same three secret forms as bearer_token above:
token = "glpat-xxxxxxxxxxxxxxxxxxxx"
#token_file = "/run/secrets/next_git_token"
#token_env  = "NEXT_GIT_TOKEN_VALUE"

# Name and email used for git commits made by next-mcp.
# Defaults: "next-mcp" / "next-mcp@unknown"
#author_name  = "next-mcp"
#author_email = "next-mcp@unknown"

# ── Sync ───────────────────────────────────────────────────────────────────────

[sync]

# Periodic background pull+push interval in seconds.
# Set to 0 to disable periodic sync entirely.
# Default: 86400 (once a day)
interval_secs = 3600

# Seconds to wait after the last mutation before firing a deferred sync.
# Keeps bulk edits snappy while ensuring data is not left un-pushed indefinitely.
# Default: 30
#deferred_delay_secs = 30

# Pull from the remote before answering a query so clients always see
# up-to-date data. The pull is best-effort and never blocks a command.
# Default: true
#pull_before_query = true

# How long (seconds) a local copy stays "fresh" after a pull. A pull is
# skipped if the last one completed within this window.
# Default: 3600 (1 hour)
#staleness_secs = 3600

# Timeout (seconds) for the pre-query pull before it is abandoned.
# Default: 10
#pull_timeout_secs = 10
